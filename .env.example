# Local development only — not used by SAM-deployed Lambdas.
# Copy to .env and adjust for your account.

AWS_REGION=us-east-1

# DynamoDB table names (defaults match deployment.yaml when ResourceSuffix is empty)
AGENT_TABLE=deployweave-agent-registry
ADAPTER_TABLE=deployweave-adapter-catalog
METRICS_TABLE=deployweave-model-metrics
CONTRACT_TABLE=deployweave-contracts

# Optional shared observatory table (from a separate shared-platform stack)
# OBSERVATORY_METRICS_TABLE=observatory-metrics-example

# Populated after deploy (stack outputs)
# CLEANUP_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/deployweave-cleanup-queue
# ALERTS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:deployweave-alerts-dev

# Token-gated HTTP invoke (stack output)
# INVOKE_URL=https://example.execute-api.us-east-1.amazonaws.com/Prod
